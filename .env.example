# Copy file này thành .env và điền thông tin thật
# KHÔNG commit file .env lên git

# Lấy từ: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Telegram bot token
TELEGRAM_BOT_TOKEN=123456789:AAF...

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Admin Telegram IDs (dùng /addtoken command) — nhiều người ngăn cách bởi dấu phẩy
# Lấy ID: nhắn @userinfobot trên Telegram
ADMIN_USER_IDS=7011450357

# Railway public URL (không có dấu / ở cuối) — dùng cho webhook
# Lấy từ Railway → Settings → Domains
APP_URL=https://your-app.up.railway.app

# MoMo Business (lấy từ business.momo.vn → Tích hợp API)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Deep link về bot sau khi thanh toán (thay your_bot bằng username bot)
MOMO_REDIRECT_URL=https://t.me/your_bot

# ZaloPay (lấy từ developer.zalopay.vn → Ứng dụng của tôi)
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_REDIRECT_URL=https://t.me/your_bot
